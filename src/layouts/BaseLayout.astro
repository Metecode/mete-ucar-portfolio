---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mete Uçar — Frontend Developer',
  description = "Mete Uçar — kurumsal sigorta ürünleri üzerine çalışan mid-level frontend developer. React, TypeScript, MUI, React Hook Form, Zod.",
} = Astro.props;
---

<!doctype html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body>

  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <a href="#main" class="skip-link">İçeriğe geç</a>

  <slot />

  <script>
    // motion/pointer capability checks
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fine = window.matchMedia('(pointer: fine)').matches;

    // scroll progress bar (rAF-throttled)
    var progressBar = document.getElementById('scroll-progress');
    var ticking = false;

    function updateOnScroll(){
      var scrollTop = window.scrollY;
      var docHeight = document.documentElement.scrollHeight - window.innerHeight;
      progressBar.style.width = (docHeight > 0 ? (scrollTop / docHeight) * 100 : 0) + '%';
      ticking = false;
    }
    document.addEventListener('scroll', function(){
      if(!ticking){ requestAnimationFrame(updateOnScroll); ticking = true; }
    }, {passive:true});
    updateOnScroll();

    // entrance animations on load (nav links etc. keyed off body.is-ready)
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        document.body.classList.add('is-ready');
      });
    });

    // stagger grid children, then reveal (single + staggered) via one observer
    document.querySelectorAll('.work-grid, .project-grid, .article-grid, .photo-grid').forEach(function(grid){
      Array.prototype.forEach.call(grid.children, function(child, i){
        child.classList.add('reveal-item');
        child.style.transitionDelay = (i * 70) + 'ms';
      });
    });
    var reveals = document.querySelectorAll('.reveal, .reveal-item, .reveal-wipe');
    if('IntersectionObserver' in window){
      // Chromium, hedefin kendi clip-path'ini kesişim alanına uyguladığı için tamamen
      // kırpılmış .reveal-wipe elementlerinde intersectionRatio hep 0 kalır; onlar
      // isIntersecting ile, diğerleri eskisi gibi 0.12 ratio eşiğiyle tetiklenir.
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(!entry.isIntersecting) return;
          if(entry.intersectionRatio >= 0.12 || entry.target.classList.contains('reveal-wipe')){
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, {threshold:[0, 0.12]});
      reveals.forEach(function(el){ io.observe(el); });
    } else {
      reveals.forEach(function(el){ el.classList.add('is-visible'); });
    }

    if(fine && !reduceMotion){
      // cursor-tracked ambient glow: panel sections (about, stack strip)
      document.querySelectorAll('.has-glow').forEach(function(el){
        el.addEventListener('pointermove', function(e){
          var r = el.getBoundingClientRect();
          el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          el.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });

      // cursor-tracked spotlight: work/article cards (delegated)
      document.addEventListener('pointermove', function(e){
        var card = e.target.closest ? e.target.closest('.work-card, .article-card') : null;
        if(!card) return;
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });

      // magnetic primary buttons
      document.querySelectorAll('.btn-primary').forEach(function(btn){
        btn.addEventListener('pointermove', function(e){
          var r = btn.getBoundingClientRect();
          var relX = e.clientX - r.left - r.width / 2;
          var relY = e.clientY - r.top - r.height / 2;
          btn.style.transform = 'translate(' + (relX * 0.18) + 'px,' + (relY * 0.35) + 'px)';
        });
        btn.addEventListener('pointerleave', function(){ btn.style.transform = ''; });
      });
    }
  </script>

</body>
</html>
