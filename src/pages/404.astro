---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, t } from '../i18n/ui';

// Statik barindirmada tek bir 404.html her yol icin servis edilir; dil bu yuzden
// varsayilana (tr) duser ve sayfanin diger dilde birebir karsiligi yoktur:
// hreflang uretilmez, dil degistirici de ilgili dilin ana sayfasina goturur.
const lang = getLangFromUrl(Astro.url);
const home = getRelativeLocaleUrl(lang, '');
---

<BaseLayout
  title={t('meta.404.title', lang)}
  description={t('meta.404.description', lang)}
  alternates={false}
>
  <Nav localeSwitchPath="" />

  <main id="main" class="notfound">
    <div class="container notfound-inner">
      <p class="notfound-code">{t('notfound.code', lang)}</p>
      <h1>{t('notfound.title', lang)}</h1>
      <p class="notfound-text">{t('notfound.text', lang)}</p>
      <div class="notfound-actions">
        <a href={home} class="btn btn-primary">
          {t('notfound.home', lang)}
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href={`${home}#iletisim`} class="btn btn-ghost">{t('notfound.contact', lang)}</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /* ---------- 404 ---------- */
  .notfound{display:flex;align-items:center;min-height:calc(100dvh - var(--header-h) - 130px);
    padding-block:clamp(64px,12vw,120px);}
  .notfound-inner{max-width:52ch;}
  .notfound-code{font-family:var(--font-mono);font-size:13px;color:var(--accent);letter-spacing:.08em;}
  .notfound h1{font-size:clamp(32px,5.4vw,56px);letter-spacing:-.02em;margin-top:14px;}
  .notfound-text{color:var(--text-secondary);margin-top:18px;font-size:16px;line-height:1.65;}
  .notfound-actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:32px;}
</style>
