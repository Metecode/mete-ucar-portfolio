---
import { Image } from 'astro:assets';
import fishing from '../assets/off-the-clock/fishing.jpeg';
import hiking from '../assets/off-the-clock/hiking.jpeg';
import paddleboard from '../assets/off-the-clock/paddleboard.jpeg';

import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const photos = [
  { src: fishing, alt: t('off.photo.fishing.alt', lang) },
  { src: hiking, alt: t('off.photo.hiking.alt', lang) },
  { src: paddleboard, alt: t('off.photo.paddleboard.alt', lang) },
];
---

<section id="off-the-clock" class="section section-alt">
  <div class="container">
    <h2 class="reveal-wipe">{t('off.title', lang)}</h2>
    <p class="section-intro">{t('off.intro', lang)}</p>

    <div class="photo-grid">
      {photos.map((photo) => (
        <figure class="photo-placeholder">
          <div class="photo-placeholder-inner">
            <Image src={photo.src} alt={photo.alt} width={750} height={1000} format="webp" loading="lazy" />
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ---------- off the clock ---------- */
  .photo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:36px;align-items:start;}
  @media (min-width:640px){ .photo-grid{grid-template-columns:repeat(3,1fr);} }
  .photo-placeholder{aspect-ratio:4/5;background:var(--surface);border:1px solid var(--border-strong);
    border-radius:var(--radius-md);overflow:hidden;margin:0;transition:border-color var(--dur) var(--ease);}
  .photo-placeholder:hover{border-color:var(--accent);}
  .photo-placeholder:nth-child(3n+2){aspect-ratio:1/1;}
  .photo-placeholder:nth-child(3n+3){aspect-ratio:5/4;}
  .photo-placeholder-inner{width:100%;height:100%;display:flex;align-items:center;justify-content:center;
    transition:transform 520ms var(--ease);}
  .photo-placeholder:hover .photo-placeholder-inner{transform:scale(1.06);}
  .photo-placeholder-inner img{width:100%;height:100%;object-fit:cover;display:block;}
</style>
