---
import { Image } from 'astro:assets';
import fishing from '../assets/off-the-clock/fishing.jpeg';
import hiking from '../assets/off-the-clock/hiking.jpeg';
import paddleboard from '../assets/off-the-clock/paddleboard.jpeg';

import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const photos = [
  { src: fishing, alt: t('off.photo.fishing.alt', lang), caption: t('off.photo.fishing.caption', lang) },
  { src: hiking, alt: t('off.photo.hiking.alt', lang), caption: t('off.photo.hiking.caption', lang) },
  { src: paddleboard, alt: t('off.photo.paddleboard.alt', lang), caption: t('off.photo.paddleboard.caption', lang) },
];
---

<section id="off-the-clock" class="section section-alt">
  <div class="container">
    <h2 class="reveal-wipe">{t('off.title', lang)}</h2>
    <p class="section-intro">{t('off.intro', lang)}</p>

    <div class="photo-grid">
      {photos.map((photo) => (
        <figure class="photo-card">
          <div class="photo-media">
            <Image src={photo.src} alt={photo.alt} width={750} height={1000} format="webp" loading="lazy" class="photo-img" />
          </div>
          <figcaption class="photo-caption">{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ---------- off the clock ---------- */
  .photo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:36px;}
  @media (min-width:640px){ .photo-grid{grid-template-columns:repeat(3,1fr);} }
  .photo-card{display:flex;flex-direction:column;border:1px solid var(--border-strong);
    border-radius:var(--radius-md);overflow:hidden;background:var(--surface);margin:0;
    transition:border-color var(--dur) var(--ease);}
  .photo-card:hover{border-color:var(--accent);}

  .photo-media{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--surface);}

  .photo-img{width:100%;height:100%;object-fit:cover;display:block;
    transition:transform 520ms var(--ease);transform-origin:center;}
  .photo-card:hover .photo-img{transform:scale(1.06);}

  .photo-caption{padding:10px 14px;font-family:var(--font-mono);
    font-size:11.5px;color:var(--text-muted);border-top:1px solid var(--border);flex-shrink:0;}
</style>
