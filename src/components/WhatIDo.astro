---
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const items = [
  { file: 'work.card1.file', title: 'work.card1.title', desc: 'work.card1.desc' },
  { file: 'work.card2.file', title: 'work.card2.title', desc: 'work.card2.desc' },
  { file: 'work.card3.file', title: 'work.card3.title', desc: 'work.card3.desc' },
] as const;
---

<!-- Kart degil, numarali form maddeleri: Projeler bolumu kart kullandigi icin
     burada ayni sablon tekrar edilmez. Teknoloji etiketleri de yok; tek kaynagi
     StackStrip. Ilk madde ana is oldugu icin basligi daha buyuk. -->
<section id="ne-yapiyorum" class="section section-alt">
  <div class="container">
    <h2 class="reveal-wipe">{t('work.title', lang)}</h2>

    <ol class="work-list">
      {items.map((item, i) => (
        <li class:list={['work-item', { 'is-lead': i === 0 }]}>
          <p class="field-label work-item-label">
            <span class="field-no">{String(i + 1).padStart(2, '0')}</span>
            <span>{t(item.file, lang)}</span>
          </p>
          <h3>{t(item.title, lang)}</h3>
          <p class="work-item-desc">{t(item.desc, lang)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  /* ---------- what i do ---------- */
  .work-list{margin-top:36px;border-top:1px solid var(--border-strong);}
  .work-item{display:grid;gap:10px;padding-block:26px;border-bottom:1px solid var(--border);}
  .work-item h3{font-size:19px;line-height:1.3;max-width:24ch;}
  .work-item-desc{color:var(--text-secondary);font-size:15px;line-height:1.7;max-width:60ch;}
  .work-item.is-lead h3{font-size:clamp(22px,2.4vw,28px);}
  @media (min-width:860px){
    .work-item{grid-template-columns:160px minmax(0,1fr) minmax(0,1.15fr);gap:32px;align-items:baseline;
      padding-block:32px;}
    .work-item.is-lead{padding-block:44px;}
  }
</style>
