---
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const cards = [
  {
    flagship: true,
    file: 'work.card1.file',
    title: 'work.card1.title',
    desc: 'work.card1.desc',
    tags: ['work.card1.tag1', 'work.card1.tag2', 'work.card1.tag3'],
  },
  {
    flagship: false,
    file: 'work.card2.file',
    title: 'work.card2.title',
    desc: 'work.card2.desc',
    tags: ['work.card2.tag1', 'work.card2.tag2', 'work.card2.tag3'],
  },
  {
    flagship: false,
    file: 'work.card3.file',
    title: 'work.card3.title',
    desc: 'work.card3.desc',
    tags: ['work.card3.tag1', 'work.card3.tag2', 'work.card3.tag3'],
  },
] as const;
---

<section id="ne-yapiyorum" class="section section-alt has-ghost">
  <span class="ghost-text" aria-hidden="true">{t('work.ghost', lang)}</span>
  <div class="container">
    <h2 class="reveal-wipe">{t('work.title', lang)}</h2>

    <div class="work-grid">
      {cards.map((card) => (
        <article class:list={['work-card', { 'work-card--flagship': card.flagship }]}>
          <div class="work-card-tab">
            <span class="work-card-dot"></span>
            <span class="work-card-filename">{t(card.file, lang)}</span>
          </div>
          <div class="work-card-body">
            <h3>{t(card.title, lang)}</h3>
            <p>{t(card.desc, lang)}</p>
            <ul class="tag-list">
              {card.tags.map((tag) => <li>{t(tag, lang)}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ---------- what i do ---------- */
  .work-grid{display:grid;gap:20px;margin-top:40px;}
  @media (min-width:768px){
    .work-grid{grid-template-columns:repeat(3,1fr);}
  }
  .work-card--flagship .work-card-body{padding:26px 28px 28px;}
  .work-card--flagship h3{font-size:21px;}
</style>
