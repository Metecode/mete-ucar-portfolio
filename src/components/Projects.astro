---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLangFromUrl, pick, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="projeler" class="section">
  <div class="container">
    <h2>{t('projects.title', lang)}</h2>
    <p class="section-intro">{t('projects.intro', lang)}</p>

    {projects.length === 0 && (
      <p class="empty-state">
        {t('projects.empty.text', lang)}
        <a href="#iletisim">{t('projects.empty.link', lang)}</a>.
      </p>
    )}

    <div class="project-grid">
      {projects.map((project) => (
        <article class="work-card project-card">
          <div class="work-card-tab">
            <span class="work-card-dot"></span>
            <span class="work-card-filename">{project.data.filename}</span>
            {project.data.badge && <span class="project-badge">{pick(project.data.badge, lang)}</span>}
          </div>
          <div
            class:list={['project-preview', `is-${project.data.imageFit}`]}
            style={[
              project.data.imageBg && `background:${project.data.imageBg}`,
              project.data.imagePosition && `--img-pos:${project.data.imagePosition}`,
            ].filter(Boolean).join(';') || undefined}
          >
            {project.data.image ? (
              <Image src={project.data.image} alt={pick(project.data.title, lang)} loading="lazy" />
            ) : (
              <span class="project-preview-label">{t('projects.preview.placeholder', lang)}</span>
            )}
          </div>
          <div class="work-card-body">
            <h3>{pick(project.data.title, lang)}</h3>
            <p>{pick(project.data.description, lang)}</p>
            <ul class="tag-list">
              {project.data.stack.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="project-links">
              <a href={project.data.link} class="project-link" target="_blank" rel="noopener noreferrer">
                {pick(project.data.linkLabel, lang)}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              {project.data.demo && (
                <a href={project.data.demo} class="project-link project-link-secondary" target="_blank" rel="noopener noreferrer">
                  {t('projects.link.demo', lang)}
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
              {project.data.repo && (
                <a href={project.data.repo} class="project-link project-link-secondary" target="_blank" rel="noopener noreferrer">
                  {t('projects.link.repo', lang)}
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ---------- projeler ---------- */
  .project-grid{display:grid;gap:20px;margin-top:40px;}
  @media (min-width:768px){ .project-grid{grid-template-columns:repeat(3,1fr);} }
  .project-preview{aspect-ratio:16/10;background:var(--surface);border-bottom:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .project-preview img{width:100%;height:100%;object-fit:cover;object-position:var(--img-pos,top center);display:block;}
  .project-preview.is-contain img{object-fit:contain;object-position:center;padding:26px;}
  .project-preview-label{font-family:var(--font-mono);font-size:11.5px;color:var(--text-muted);}
  .project-badge{display:inline-block;font-family:var(--font-mono);font-size:9.5px;color:var(--text-muted);
    border:1px solid var(--border);border-radius:20px;padding:3px 9px;margin-left:auto;flex-shrink:0;
    text-transform:uppercase;letter-spacing:.06em;}
  /* margin-top, link'lere verilen min-height'in getirdigi ust bosluk kadar kisildi */
  .project-links{margin-top:5px;display:flex;flex-wrap:wrap;align-items:center;gap:0 18px;}
  /* min-height:44px -> dokunma hedefi (WCAG 2.5.8); gorsel yukseklik metin kadar kalir */
  .project-link{display:inline-flex;align-items:center;min-height:44px;gap:6px;font-size:13.5px;
    color:var(--accent-link);}
  .project-link svg{transition:transform var(--dur) var(--ease);}
  .project-link:hover svg{transform:translateX(3px);}
  .project-link-secondary{color:var(--text-muted);}
  .project-link-secondary:hover{color:var(--accent);}
</style>
