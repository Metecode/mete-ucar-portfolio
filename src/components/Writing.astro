---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="yazilar" class="section">
  <div class="container">
    <div class="section-header-row">
      <div>
        <h2 class="reveal-wipe">Yazılar</h2>
      </div>
      <a class="text-link" href="https://medium.com/@i.meteucar" target="_blank" rel="noopener">Medium'da tümünü gör →</a>
    </div>

    <div class="article-grid">
      {articles.map((article) => (
        <a
          class:list={['article-card', { 'is-featured': article.data.featured }]}
          href={article.data.link}
          target="_blank"
          rel="noopener"
        >
          <p class="article-meta">{article.data.readingTime}</p>
          <h3>{article.data.title}</h3>
          <p>{article.data.excerpt}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ---------- writing ---------- */
  .article-grid{display:grid;gap:20px;margin-top:36px;}
  @media (min-width:768px){ .article-grid{grid-template-columns:repeat(2,1fr);} }
  .article-card{position:relative;overflow:hidden;display:block;background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius-md);padding:24px;transition:border-color var(--dur) var(--ease),transform var(--dur) var(--ease);}
  .article-card::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;
    background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(124,134,255,.10),transparent 72%);
    transition:opacity 320ms ease;}
  .article-card:hover::before{opacity:1;}
  .article-card:hover{border-color:var(--accent);transform:translateY(-3px);}
  .article-meta{font-family:var(--font-mono);font-size:12px;color:var(--text-muted);margin-bottom:10px;}
  .article-card h3{font-size:17px;margin-bottom:8px;font-weight:500;}
  .article-card p{color:var(--text-secondary);font-size:14px;line-height:1.6;}
  @media (min-width:768px){
    .article-card.is-featured{grid-column:1 / -1;padding:34px;border-left:2px solid var(--accent);}
    .article-card.is-featured h3{font-size:23px;}
  }
</style>
