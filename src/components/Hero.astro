---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero.jpg';
---

<section id="hero" class="hero">
  <span class="ghost-text" aria-hidden="true">FRONTEND</span>
  <div class="container hero-grid">
    <div class="hero-content">
      <h1>
        <span class="line"><span>Karmaşık iş kurallarını,</span></span>
        <span class="line"><span>güvenilir arayüzlere</span></span>
        <span class="line"><span>dönüştürüyorum.</span></span>
      </h1>
      <p class="hero-sub hero-slide hero-slide-left" style="transition-delay:120ms;">32Bit bünyesinde kurumsal sigorta ürünleri için React, TypeScript ve tip güvenli form mimarileri üzerine çalışan bir frontend developer'ım.</p>
      <div class="hero-actions hero-slide hero-slide-left" style="transition-delay:220ms;">
        <a href="#iletisim" class="btn btn-primary">
          İletişime geç
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#ne-yapiyorum" class="btn btn-ghost">Ne yaptığımı gör</a>
      </div>
      <dl class="role-card hero-slide hero-slide-right" style="transition-delay:320ms;">
        <div class="role-row"><dt>role</dt><dd>"Frontend developer"</dd></div>
        <div class="role-row"><dt>focus</dt><dd>"Enterprise systems"</dd></div>
        <div class="role-row"><dt>stack</dt><dd>React · TypeScript · MUI · RHF · Zod</dd></div>
      </dl>
    </div>

    <div class="hero-photo">
      <div class="hero-photo-frame">
        <div class="hero-photo-layer hero-photo-color">
          <Image src={heroPhoto} alt="Mete Uçar" />
        </div>
        <div class="hero-photo-layer hero-photo-bw">
          <Image src={heroPhoto} alt="" aria-hidden="true" />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- hero ---------- */
  .hero{position:relative;overflow:hidden;padding-block:clamp(80px,15vw,180px) clamp(64px,10vw,120px);}
  .hero::before{content:"";position:absolute;inset:-15%;pointer-events:none;z-index:0;
    background:radial-gradient(560px circle at var(--mx,50%) var(--my,15%),rgba(124,134,255,.16),transparent 62%);}
  .hero .container{position:relative;z-index:1;}
  .hero h1{font-size:clamp(38px,6.4vw,72px);max-width:14ch;letter-spacing:-.02em;line-height:1.12;}
  .hero h1 .line{display:block;overflow:hidden;}
  .hero h1 .line span{display:block;transform:translateY(110%);transition:transform 700ms var(--ease);}
  .hero.is-ready h1 .line span{transform:translateY(0);}
  .hero h1 .line:nth-child(2) span{transition-delay:90ms;}
  .hero h1 .line:nth-child(3) span{transition-delay:180ms;}
  .hero-sub{margin-top:22px;color:var(--text-secondary);max-width:56ch;font-size:17px;line-height:1.65;}
  .hero-actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:32px;}

  .hero-grid{display:grid;gap:48px;align-items:center;}
  @media (min-width:900px){ .hero-grid{grid-template-columns:1.15fr 0.85fr;gap:56px;} }

  .hero-slide{opacity:0;transition:opacity 700ms var(--ease-smooth),transform 700ms var(--ease-smooth);}
  .hero-slide-left{transform:translateX(-24px);}
  .hero-slide-right{transform:translateX(24px);}
  .hero.is-ready .hero-slide{opacity:1;transform:translateX(0);}

  .hero-photo-frame{position:relative;aspect-ratio:4/5;max-width:380px;margin-inline:auto;
    border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border);background:var(--surface);
    opacity:0;transform:translateY(36px);transition:opacity 800ms var(--ease-smooth),transform 800ms var(--ease-smooth);
    transition-delay:160ms;}
  .hero.is-ready .hero-photo-frame{opacity:1;transform:translateY(0);}
  .hero-photo-layer{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
  .hero-photo-layer img{width:100%;height:100%;object-fit:cover;object-position:center 18%;display:block;}
  .hero-photo-bw img{filter:grayscale(100%) contrast(1.02);}
  .hero-photo-bw{
    mask-image:radial-gradient(circle 110px at var(--px,50%) var(--py,42%),transparent 0,transparent 68px,black 128px);
    -webkit-mask-image:radial-gradient(circle 110px at var(--px,50%) var(--py,42%),transparent 0,transparent 68px,black 128px);}

  .role-card{margin-top:44px;display:inline-block;background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius-md);padding:18px 22px;font-family:var(--font-mono);font-size:13px;}
  .role-row{display:flex;gap:18px;padding:3px 0;}
  .role-row dt{color:var(--text-muted);width:52px;flex-shrink:0;}
  .role-row dd{margin:0;color:var(--text-secondary);}
</style>

<script>
  // motion/pointer capability checks
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = window.matchMedia('(pointer: fine)').matches;
  var hero = document.getElementById('hero');

  // hero parallax (rAF-throttled)
  var heroGhost = hero.querySelector('.ghost-text');
  var heroInner = hero.querySelector('.container');
  var ticking = false;

  function updateParallax(){
    if(!reduceMotion){
      var heroHeight = hero.offsetHeight || 1;
      var rect = hero.getBoundingClientRect();
      var progress = Math.min(Math.max(-rect.top / heroHeight, 0), 1);
      if(heroGhost){ heroGhost.style.transform = 'translate(-50%,-50%) translateY(' + (progress * 40) + 'px)'; }
      if(heroInner){
        heroInner.style.transform = 'translateY(' + (progress * -30) + 'px)';
        heroInner.style.opacity = String(1 - progress * 0.6);
      }
    }
    ticking = false;
  }
  document.addEventListener('scroll', function(){
    if(!ticking){ requestAnimationFrame(updateParallax); ticking = true; }
  }, {passive:true});
  updateParallax();

  // hero line-by-line reveal on load
  requestAnimationFrame(function(){
    requestAnimationFrame(function(){
      hero.classList.add('is-ready');
    });
  });

  if(fine && !reduceMotion){
    // cursor-tracked ambient glow
    hero.addEventListener('pointermove', function(e){
      var r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      hero.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });

    // hero photo: grayscale-to-color reveal following cursor
    var heroPhotoFrame = document.querySelector('.hero-photo-frame');
    if(heroPhotoFrame){
      heroPhotoFrame.addEventListener('pointermove', function(e){
        var r = heroPhotoFrame.getBoundingClientRect();
        heroPhotoFrame.style.setProperty('--px', (e.clientX - r.left) + 'px');
        heroPhotoFrame.style.setProperty('--py', (e.clientY - r.top) + 'px');
      });
    }
  }
</script>
