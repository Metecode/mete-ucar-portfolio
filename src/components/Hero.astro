---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero.jpg';
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
---

<section id="hero" class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <!-- isim bir rozet degil, imza satiri: kapsul/zemin yok, duz metin.
           Rol ve konum burada tekrarlanmaz; tek kaynagi Hakkimda'daki form satirlari. -->
      <p class="hero-byline hero-slide">
        <span class="hero-byline-name">Mete Uçar</span>
        <span class="hero-byline-role">{t('hero.byline.role', lang)}</span>
      </p>
      <h1>
        <span class="line"><span>{t('hero.line1', lang)}</span></span>
        <span class="line"><span>{t('hero.line2', lang)}</span></span>
        <span class="line"><span>{t('hero.line3', lang)}</span></span>
      </h1>
      <p class="hero-sub hero-slide" style="transition-delay:120ms;">{t('hero.sub', lang)}</p>
      <!-- tek birincil eylem; ikincisi buton degil metin linki (esit agirlikli ikili buton yok) -->
      <div class="hero-actions hero-slide" style="transition-delay:220ms;">
        <a href="#iletisim" class="btn btn-primary">
          {t('hero.cta.primary', lang)}
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/cv.pdf" download="Mete-Ucar-CV.pdf" class="cv-link">
          {t('hero.cv.label', lang)}
          <svg class="cv-link-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 2V9M7 9L4 6M7 9L10 6M2.5 11H11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-photo">
      <div class="hero-photo-frame">
        <Image src={heroPhoto} alt={t('hero.photo.alt', lang)} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- hero ---------- */
  .hero{padding-block:clamp(28px,4vw,56px) clamp(64px,10vw,120px);}
  .hero-byline{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin-bottom:22px;}
  .hero-byline-name{font-family:var(--font-display);font-size:18px;font-weight:500;color:var(--text-primary);}
  .hero-byline-role{font-family:var(--font-mono);font-size:12.5px;color:var(--text-muted);}
  .hero h1{font-size:clamp(34px,5.4vw,58px);max-width:14ch;letter-spacing:-.02em;line-height:1.12;}
  .hero h1 .line{display:block;overflow:hidden;}
  .hero h1 .line span{display:block;transform:translateY(110%);transition:transform 700ms var(--ease);}
  .hero.is-ready h1 .line span{transform:translateY(0);}
  .hero h1 .line:nth-child(2) span{transition-delay:90ms;}
  .hero h1 .line:nth-child(3) span{transition-delay:180ms;}
  .hero-sub{margin-top:18px;color:var(--text-secondary);max-width:56ch;font-size:17px;line-height:1.65;}
  .hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;margin-top:28px;}

  .hero-grid{display:grid;gap:40px;align-items:start;}
  @media (min-width:900px){ .hero-grid{grid-template-columns:1.15fr 0.85fr;gap:32px;} }

  .hero-slide{opacity:0;transform:translateY(10px);
    transition:opacity 600ms var(--ease-smooth),transform 600ms var(--ease-smooth);}
  .hero.is-ready .hero-slide{opacity:1;transform:translateY(0);}

  /* portre kare kirpildi; cerceve onu yeniden kesmesin diye ayni oranda */
  .hero-photo-frame{aspect-ratio:1/1;max-width:420px;margin-inline:auto;
    border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border);background:var(--surface);
    opacity:0;transition:opacity 800ms var(--ease-smooth) 160ms;}
  .hero.is-ready .hero-photo-frame{opacity:1;}
  .hero-photo-frame img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;}

  /* CV: ikincil eylem, metin linki. min-height 44px -> dokunma hedefi (WCAG 2.5.8) */
  .cv-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:14px;font-weight:500;
    color:var(--text-primary);text-decoration:underline;text-decoration-color:var(--border-strong);
    text-underline-offset:5px;text-decoration-thickness:1px;
    transition:color var(--dur) var(--ease),text-decoration-color var(--dur) var(--ease);}
  .cv-link:hover{color:var(--accent-link);text-decoration-color:currentColor;}
  .cv-link-icon{flex-shrink:0;}
  .cv-link:hover .cv-link-icon{animation:cv-bounce 700ms var(--ease-smooth);}
</style>

<script>
  // hero satir satir acilis
  var hero = document.getElementById('hero');
  requestAnimationFrame(function(){
    requestAnimationFrame(function(){
      hero.classList.add('is-ready');
    });
  });
</script>
