---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero.jpg';
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const roleRows = [
  { label: 'hero.card.role.label', value: 'hero.card.role.value' },
  { label: 'hero.card.focus.label', value: 'hero.card.focus.value' },
  { label: 'hero.card.stack.label', value: 'hero.card.stack.value' },
  { label: 'hero.card.location.label', value: 'hero.card.location.value' },
] as const;
---

<section id="hero" class="hero">
  <span class="ghost-text" aria-hidden="true">{t('hero.ghost', lang)}</span>
  <div class="container hero-grid">
    <div class="hero-content">
      <h1>
        <span class="line"><span>{t('hero.line1', lang)}</span></span>
        <span class="line"><span>{t('hero.line2', lang)}</span></span>
        <span class="line"><span>{t('hero.line3', lang)}</span></span>
      </h1>
      <p class="hero-sub hero-slide hero-slide-left" style="transition-delay:120ms;">{t('hero.sub', lang)}</p>
      <div class="hero-actions hero-slide hero-slide-left" style="transition-delay:220ms;">
        <a href="#iletisim" class="btn btn-primary">
          {t('hero.cta.primary', lang)}
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#ne-yapiyorum" class="btn btn-ghost">{t('hero.cta.secondary', lang)}</a>
      </div>
      <dl class="role-card hero-slide hero-slide-right" style="transition-delay:320ms;">
        {roleRows.map((row) => (
          <div class="role-row"><dt>{t(row.label, lang)}</dt><dd>{t(row.value, lang)}</dd></div>
        ))}
      </dl>
      <a href="/cv.pdf" download="Mete-Ucar-CV.pdf" class="cv-chip hero-slide hero-slide-right" style="transition-delay:380ms;" aria-label={t('hero.cv.aria', lang)}>
        <span class="cv-chip-dot"></span>
        <span class="cv-chip-filename">resume.pdf</span>
        <svg class="cv-chip-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 2V9M7 9L4 6M7 9L10 6M2.5 11H11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="hero-photo">
      <div class="hero-photo-frame">
        <div class="hero-photo-layer hero-photo-color">
          <Image src={heroPhoto} alt={t('hero.photo.alt', lang)} loading="eager" fetchpriority="high" />
        </div>
        <div class="hero-photo-layer hero-photo-bw">
          <Image src={heroPhoto} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
        </div>
      </div>
      <div class="hero-identity-card">
        <p class="hero-identity-name">Mete Uçar</p>
        <p class="hero-identity-role">{t('hero.identity.role', lang)}</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- hero ---------- */
  .hero{position:relative;overflow:hidden;padding-block:clamp(28px,2.5vw,48px) clamp(64px,10vw,120px);}
  .hero::before{content:"";position:absolute;inset:-15%;pointer-events:none;z-index:0;
    background:radial-gradient(560px circle at var(--mx,50%) var(--my,15%),rgba(124,134,255,.16),transparent 62%);}
  .hero .container{position:relative;z-index:1;}
  .hero h1{font-size:clamp(34px,5.4vw,58px);max-width:14ch;letter-spacing:-.02em;line-height:1.12;}
  .hero h1 .line{display:block;overflow:hidden;}
  .hero h1 .line span{display:block;transform:translateY(110%);transition:transform 700ms var(--ease);}
  .hero.is-ready h1 .line span{transform:translateY(0);}
  .hero h1 .line:nth-child(2) span{transition-delay:90ms;}
  .hero h1 .line:nth-child(3) span{transition-delay:180ms;}
  .hero-sub{margin-top:14px;color:var(--text-secondary);max-width:56ch;font-size:17px;line-height:1.65;}
  .hero-actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:20px;}

  .hero-grid{display:grid;gap:32px;align-items:start;}
  @media (min-width:900px){ .hero-grid{grid-template-columns:1.15fr 0.85fr;gap:32px;} }

  .hero-slide{opacity:0;transition:opacity 700ms var(--ease-smooth),transform 700ms var(--ease-smooth);}
  .hero-slide-left{transform:translateX(-24px);}
  .hero-slide-right{transform:translateX(24px);}
  .hero.is-ready .hero-slide{opacity:1;transform:translateX(0);}

  .hero-photo-frame{position:relative;aspect-ratio:4/5;max-width:380px;margin-inline:auto;
    border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border);background:var(--surface);
    opacity:0;transform:translateY(36px);transition:opacity 800ms var(--ease-smooth),transform 800ms var(--ease-smooth);
    transition-delay:160ms;}
  .hero.is-ready .hero-photo-frame{opacity:1;transform:translateY(0);}
  .hero-photo-layer{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
  .hero-photo-layer img{width:100%;height:100%;object-fit:cover;object-position:center 18%;display:block;}
  .hero-photo-bw img{filter:grayscale(100%) contrast(1.02);}
  /* acik temada siyah-beyaz katman hic gosterilmez; foto her zaman renkli */
  [data-theme="light"] .hero-photo-bw{display:none;}
  .hero-photo-bw{
    mask-image:radial-gradient(circle 110px at var(--px,50%) var(--py,42%),transparent 0,transparent 68px,black 128px);
    -webkit-mask-image:radial-gradient(circle 110px at var(--px,50%) var(--py,42%),transparent 0,transparent 68px,black 128px);}

  .role-card{margin-top:20px;display:inline-block;background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius-md);padding:14px 18px 16px;font-family:var(--font-mono);font-size:13px;}
  .role-row{display:flex;gap:18px;padding:2px 0;}
  .role-row dt{color:var(--text-muted);min-width:64px;flex-shrink:0;}
  .role-row dd{margin:0;color:var(--text-secondary);}

  .hero-identity-card{display:flex;flex-direction:column;gap:2px;
    margin-top:14px;padding:12px 16px;background:var(--surface);
    border:1px solid var(--border);border-radius:var(--radius-md);
    max-width:380px;margin-inline:auto;}
  .hero-identity-name{font-size:13.5px;font-weight:500;color:var(--text-primary);}
  .hero-identity-role{font-size:12px;color:var(--text-secondary);}

  .cv-chip{display:inline-flex;align-items:center;gap:9px;margin-top:10px;
    padding:9px 16px;border:1px solid var(--border);border-radius:999px;
    background:var(--surface);font-family:var(--font-mono);font-size:12.5px;
    color:var(--text-secondary);transition:border-color var(--dur) var(--ease),
    color var(--dur) var(--ease);}
  .cv-chip:hover{border-color:var(--accent);color:var(--text-primary);}
  .cv-chip-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);
    flex-shrink:0;}
  .cv-chip-icon{transition:transform 300ms var(--ease-smooth);flex-shrink:0;}
  .cv-chip:hover .cv-chip-icon{animation:cv-bounce 700ms var(--ease-smooth);}
  .cv-chip.downloading{animation:cv-pulse 500ms var(--ease-smooth);}
</style>

<script>
  // motion/pointer capability checks
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = window.matchMedia('(pointer: fine)').matches;
  var hero = document.getElementById('hero');

  // hero parallax (rAF-throttled)
  var heroGhost = hero.querySelector('.ghost-text');
  var heroInner = hero.querySelector('.container');
  var ticking = false;

  function updateParallax(){
    if(!reduceMotion){
      var heroHeight = hero.offsetHeight || 1;
      var rect = hero.getBoundingClientRect();
      var progress = Math.min(Math.max(-rect.top / heroHeight, 0), 1);
      if(heroGhost){ heroGhost.style.transform = 'translate(-50%,-50%) translateY(' + (progress * 40) + 'px)'; }
      if(heroInner){
        heroInner.style.transform = 'translateY(' + (progress * -30) + 'px)';
        heroInner.style.opacity = String(1 - progress * 0.6);
      }
    }
    ticking = false;
  }
  document.addEventListener('scroll', function(){
    if(!ticking){ requestAnimationFrame(updateParallax); ticking = true; }
  }, {passive:true});
  updateParallax();

  // hero line-by-line reveal on load
  requestAnimationFrame(function(){
    requestAnimationFrame(function(){
      hero.classList.add('is-ready');
    });
  });

  // cv chip: kisa nabiz efekti ile tiklama geri bildirimi
  var cvChip = hero.querySelector('.cv-chip');
  if(cvChip){
    cvChip.addEventListener('click', function(){
      cvChip.classList.add('downloading');
      setTimeout(function(){ cvChip.classList.remove('downloading'); }, 500);
    });
  }

  if(fine && !reduceMotion){
    // cursor-tracked ambient glow
    hero.addEventListener('pointermove', function(e){
      var r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      hero.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });

    // hero photo: grayscale-to-color reveal following cursor
    var heroPhotoFrame = document.querySelector('.hero-photo-frame');
    if(heroPhotoFrame){
      heroPhotoFrame.addEventListener('pointermove', function(e){
        var r = heroPhotoFrame.getBoundingClientRect();
        heroPhotoFrame.style.setProperty('--px', (e.clientX - r.left) + 'px');
        heroPhotoFrame.style.setProperty('--py', (e.clientY - r.top) + 'px');
      });
    }
  }
</script>
