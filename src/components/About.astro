---
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const facts = [
  { label: 'about.facts.company.label', value: 'about.facts.company.value' },
  { label: 'about.facts.role.label', value: 'about.facts.role.value' },
  { label: 'about.facts.field.label', value: 'about.facts.field.value' },
  { label: 'about.facts.location.label', value: 'about.facts.location.value' },
] as const;
---

<section id="hakkimda" class="section has-glow reveal">
  <div class="container">
    <h2>{t('about.title', lang)}</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>{t('about.p1', lang)}</p>
        <p>{t('about.p2', lang)}</p>
      </div>
      <ul class="about-facts">
        {facts.map((fact) => (
          <li>
            <span class="fact-label">{t(fact.label, lang)}</span>
            <span class="fact-value">{t(fact.value, lang)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- about ---------- */
  .about-grid{display:grid;gap:48px;margin-top:28px;}
  .about-text p{color:var(--text-secondary);max-width:62ch;font-size:16px;line-height:1.75;}
  .about-text p + p{margin-top:18px;}
  .about-facts{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-content:start;}
  .about-facts li{border-top:1px solid var(--border);padding-top:12px;}
  .fact-label{display:block;font-family:var(--font-mono);font-size:12px;color:var(--text-muted);margin-bottom:4px;}
  .fact-value{display:block;font-size:15px;color:var(--text-primary);}
  @media (min-width:860px){
    .about-grid{grid-template-columns:1.4fr 1fr;}
  }
</style>
