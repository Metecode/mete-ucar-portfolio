---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, stripLangFromPath, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const path = stripLangFromPath(Astro.url);

// bkz. Nav.astro: ana sayfa disinda capalar once o dilin ana sayfasina yonlendirilir
const home = path === '' ? '' : getRelativeLocaleUrl(lang, '');

const footerItems = [
  { id: 'hakkimda', key: 'nav.about' },
  { id: 'yazilar', key: 'nav.writing' },
  { id: 'iletisim', key: 'nav.contact' },
] as const;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>{t('footer.copyright', lang)}</p>
    <nav aria-label={t('footer.aria', lang)}>
      <ul>
        {footerItems.map((item) => (
          <li><a href={`${home}#${item.id}`}>{t(item.key, lang)}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style is:global>
  /* ---------- footer ---------- */
  .site-footer{border-top:1px solid var(--border);padding-block:32px;}
  .footer-inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;}
  .footer-inner p{color:var(--text-muted);font-size:13.5px;}
  .footer-inner nav ul{display:flex;gap:20px;}
  .footer-inner nav a{font-size:13.5px;color:var(--text-secondary);transition:color var(--dur) var(--ease);}
  .footer-inner nav a:hover{color:var(--accent);}
</style>
