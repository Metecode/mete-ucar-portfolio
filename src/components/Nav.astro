---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import logoMark from '../assets/logo-mark.png';
import { getLangFromUrl, stripLangFromPath, t, languages, type Lang } from '../i18n/ui';

interface Props {
  /**
   * Dil degistiricinin hedefleyecegi, dil onegi olmayan yol. Varsayilan olarak
   * mevcut sayfanin yolu kullanilir; 404 gibi diger dilde karsiligi olmayan
   * sayfalar "" gecerek ilgili dilin ana sayfasina yonlendirir.
   */
  localeSwitchPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const path = stripLangFromPath(Astro.url);
const { localeSwitchPath = path } = Astro.props;

// Bolum capalari yalnizca ana sayfada var. 404 gibi baska bir sayfadayken duz
// "#hakkimda" hicbir yere gitmez; onune o dilin ana sayfasi konarak once oraya
// donulur. Ana sayfadayken prefix bos kalir, davranis eskisiyle birebir ayni.
const home = path === '' ? '' : getRelativeLocaleUrl(lang, '');

// Bolum id'leri dile gore degismez: eski capa linkleri (meteucar.com/#hakkimda)
// iki dilde de calismaya devam eder.
const navItems = [
  { id: 'hakkimda', key: 'nav.about' },
  { id: 'ne-yapiyorum', key: 'nav.work' },
  { id: 'projeler', key: 'nav.projects' },
  { id: 'yazilar', key: 'nav.writing' },
  { id: 'off-the-clock', key: 'nav.offTheClock' },
] as const;

const localeLinks = (Object.keys(languages) as Lang[]).map((locale) => ({
  locale,
  href: getRelativeLocaleUrl(locale, localeSwitchPath),
  label: languages[locale],
}));
---

<header class="site-header" id="site-header">
  <div class="container nav-inner">
    <a href={`${home}#hero`} class="logo">
      <Image src={logoMark} alt="" class="logo-mark" />
      <span class="sr-only">Mete Uçar</span>
    </a>

    <nav class="nav-links" aria-label={t('nav.aria.main', lang)} id="nav-links">
      {navItems.map((item) => (
        <a href={`${home}#${item.id}`}>{t(item.key, lang)}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <div class="lang-switch" role="group" aria-label={t('nav.aria.language', lang)}>
        <span class="lang-switch-thumb" aria-hidden="true" class:list={{ 'is-en': lang === 'en' }}></span>
        {localeLinks.map(({ locale, href, label }) => (
          <a
            href={href}
            hreflang={locale}
            lang={locale}
            class:list={['lang-switch-link', { 'is-active': locale === lang }]}
            aria-current={locale === lang ? 'true' : undefined}
          >
            <span aria-hidden="true">{locale.toUpperCase()}</span>
            <span class="sr-only">{label}</span>
          </a>
        ))}
      </div>

      <button class="theme-toggle" type="button" aria-label={t('nav.aria.theme', lang)} aria-pressed="false">
        <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <a href={`${home}#iletisim`} class="nav-cta-btn">
        {t('nav.contact', lang)}
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('nav.aria.menuOpen', lang)}
        data-label-open={t('nav.aria.menuOpen', lang)} data-label-close={t('nav.aria.menuClose', lang)}>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label={t('nav.aria.mobile', lang)} hidden>
    <ul>
      {navItems.map((item) => (
        <li><a href={`${home}#${item.id}`}>{t(item.key, lang)}</a></li>
      ))}
      <li><a href={`${home}#iletisim`}>{t('nav.contact', lang)}</a></li>
    </ul>
  </nav>
</header>

<style is:global>
  /* ---------- header / nav ---------- */
  /* fixed: yukseklik degisimi (76 -> 60) akisi etkilemesin. Sticky iken bu 16px'lik
     kayma scroll anchoring ile geri sariliyor ve esik civarinda titremeye yol aciyordu.
     body'ye var(--header-h) kadar padding-top verilerek yer ayriliyor. */
  .site-header{position:fixed;top:0;left:0;right:0;z-index:100;background:color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter:saturate(1.1) blur(8px);-webkit-backdrop-filter:saturate(1.1) blur(8px);
    border-bottom:1px solid transparent;transition:border-color var(--dur) var(--ease);
    /* sabit header'i kok View Transition grubundan ayirir; yoksa dil degisirken
       sayfa icerigiyle birlikte capraz-solurken sabit konumda "hayalet" gibi ikiye
       katlanmis gorunurdu. */
    view-transition-name:site-header;}
  .site-header.scrolled{border-bottom-color:var(--border);}
  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:var(--header-h);
    transition:height 320ms var(--ease-smooth);}
  .site-header.scrolled .nav-inner{height:var(--header-h-sm);}
  /* min-height: header icinde dikey olarak 44px'lik dokunma hedefi birakir */
  .logo{display:flex;align-items:center;min-height:44px;gap:9px;font-family:var(--font-display);font-weight:500;font-size:16px;letter-spacing:.01em;}
  .logo-mark{height:22px;width:auto;display:block;filter:invert(1);transition:height 320ms var(--ease-smooth);}
  /* logo mark koyu zemin icin beyaza cevrilir; acik temada ham hali gorunur kalir */
  [data-theme="light"] .logo-mark{filter:none;}
  .site-header.scrolled .logo-mark{height:19px;}

  /* pill capsule */
  .nav-links{display:none;align-items:center;gap:4px;font-size:13.5px;color:var(--text-secondary);
    border:1px solid var(--border);background:color-mix(in srgb, var(--surface) 72%, transparent);
    border-radius:999px;padding:6px;}
  .nav-links a{position:relative;padding:8px 15px;border-radius:999px;opacity:0;transform:translateY(-10px);
    transition:color var(--dur) var(--ease),background var(--dur) var(--ease),
    opacity 560ms var(--ease-smooth),transform 560ms var(--ease-smooth);}
  body.is-ready .nav-links a{opacity:1;transform:translateY(0);}
  .nav-links a:nth-child(1){transition-delay:40ms;}
  .nav-links a:nth-child(2){transition-delay:90ms;}
  .nav-links a:nth-child(3){transition-delay:140ms;}
  .nav-links a:nth-child(4){transition-delay:190ms;}
  .nav-links a:nth-child(5){transition-delay:240ms;}
  .nav-links a:hover{color:var(--text-primary);}
  .nav-links a.active{color:var(--text-primary);}
  .nav-links a::before{content:"";position:absolute;bottom:4px;left:15px;right:15px;height:1.5px;
    border-radius:1px;background:var(--accent);transform:scaleX(0);transform-origin:center;
    transition:transform 260ms var(--ease-smooth);}
  .nav-links a.active::before{transform:scaleX(1);}

  /* nav sag grup: tema butonu + CTA + hamburger.
     Tek flex ogesi olarak durur, boylece .nav-links ortada kalir. */
  .nav-actions{display:flex;align-items:center;gap:10px;}

  /* dil degistirici: tema butonuyla ayni kapsul dilinde, iki kisa link.
     Gorsel yukseklik 38px kalir; ::after ile 44px'lik dokunma alani eklenir
     (WCAG 2.5.8) — kapsulun disina tasar ama tiklamayi engellemez. */
  .lang-switch{position:relative;display:flex;align-items:center;gap:2px;height:38px;padding:3px;
    border:1px solid var(--border);background:color-mix(in srgb, var(--surface) 72%, transparent);
    border-radius:999px;font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;}
  /* aktif dili gosteren kayar "hap": TR/EN arasinda ayri bir arkaplan yerine tek
     bir elemani kaydirarak geciyor. Ayni sayfada JS yok; gecis dil linkine tiklayip
     tam sayfa navigasyonuyla oluyor, bu yuzden asil "kayma" native View Transitions
     API'siyle sayfalar arasi saglaniyor (bkz. global.css @view-transition) --
     transform burada yalnizca reduced-motion / desteklenmeyen tarayicilarda anlik
     ama en azindan tutarli bir dususe fallback olarak duruyor. */
  .lang-switch-thumb{position:absolute;top:3px;bottom:3px;left:3px;width:calc(50% - 4px);
    border-radius:999px;background:var(--accent);transition:transform 360ms var(--ease-smooth);
    view-transition-name:lang-pill;}
  .lang-switch-thumb.is-en{transform:translateX(calc(100% + 2px));}
  .lang-switch-link{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;
    min-width:32px;height:100%;padding-inline:9px;border-radius:999px;color:var(--text-muted);
    transition:color var(--dur) var(--ease);}
  .lang-switch-link::after{content:"";position:absolute;top:50%;left:50%;
    transform:translate(-50%,-50%);width:100%;height:44px;}
  .lang-switch-link:hover{color:var(--text-primary);}
  .lang-switch-link.is-active{color:var(--accent-on);}

  /* tema degistirme butonu.
     Gorsel cap 38px kalir; ::after ile 44x44'luk gorunmez dokunma alani eklenir
     ki kaba dokunmatik girdide hedef WCAG 2.5.8'in altina dusmesin. */
  .theme-toggle::after{content:"";position:absolute;top:50%;left:50%;
    transform:translate(-50%,-50%);width:44px;height:44px;}
  .theme-toggle{position:relative;
    display:inline-flex;align-items:center;justify-content:center;
    width:38px;height:38px;flex:none;border-radius:999px;color:var(--text-secondary);
    border:1px solid var(--border);background:color-mix(in srgb, var(--surface) 72%, transparent);
    transition:color var(--dur) var(--ease),border-color var(--dur) var(--ease),
    background var(--dur) var(--ease);}
  .theme-toggle:hover{color:var(--text-primary);border-color:var(--accent);}

  /* iki ikon da her zaman DOM'da ve boyalı; display yerine transform/opacity ile
     degisirler ki gecis anime olabilsin. Ust uste, buton icinde ortalanmis. */
  .theme-toggle .icon{position:absolute;inset:0;margin:auto;width:18px;height:18px;
    transition:transform 400ms cubic-bezier(.16,1,.3,1),opacity 300ms ease;}
  /* varsayilan (data-theme henuz yokken) koyu tema durumu */
  .theme-toggle .icon-moon{transform:rotate(0) scale(1);opacity:1;}
  .theme-toggle .icon-sun{transform:rotate(-90deg) scale(0);opacity:0;}
  [data-theme="dark"] .theme-toggle .icon-moon{transform:rotate(0) scale(1);opacity:1;}
  [data-theme="dark"] .theme-toggle .icon-sun{transform:rotate(-90deg) scale(0);opacity:0;}
  [data-theme="light"] .theme-toggle .icon-sun{transform:rotate(0) scale(1);opacity:1;}
  [data-theme="light"] .theme-toggle .icon-moon{transform:rotate(90deg) scale(0);opacity:0;}

  /* nav CTA button */
  .nav-cta-btn{display:none;align-items:center;gap:7px;height:38px;padding-inline:16px;
    background:var(--accent);color:var(--accent-on);border-radius:999px;font-size:13.5px;font-weight:500;
    opacity:0;transform:translateY(-10px);
    transition:background var(--dur) var(--ease),opacity 560ms var(--ease-smooth) 300ms,
    transform 560ms var(--ease-smooth) 300ms;}
  body.is-ready .nav-cta-btn{opacity:1;transform:translateY(0);}
  .nav-cta-btn:hover{background:var(--accent-hover);}
  .nav-cta-btn svg{transition:transform var(--dur) var(--ease);}
  .nav-cta-btn:hover svg{transform:translateX(3px);}

  .nav-toggle{display:flex;flex-direction:column;justify-content:center;gap:5px;width:44px;height:44px;
    align-items:center;}
  .nav-toggle-bar{width:20px;height:1.5px;background:var(--text-primary);transition:transform var(--dur) var(--ease),opacity var(--dur) var(--ease);}
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2){opacity:0;}
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}

  @media (min-width:900px){
    .nav-links{display:flex;}
    .nav-cta-btn{display:inline-flex;}
    .nav-toggle{display:none;}
  }

  .mobile-nav{border-top:1px solid var(--border);background:var(--bg);
    max-height:calc(100dvh - var(--header-h-sm));overflow-y:auto;}
  .mobile-nav[hidden]{display:none;}
  .mobile-nav ul{display:flex;flex-direction:column;padding:12px 24px 24px;}
  .mobile-nav a{display:block;padding:14px 0;font-size:16px;color:var(--text-secondary);border-bottom:1px solid var(--border);}
  .mobile-nav a:last-child{border-bottom:none;color:var(--accent);}
</style>

<script>
  // Hamburger'in acik/kapali aria-label'lari sunucuda sozlukten cozulup data-*
  // ile aktarilir; boylece istemci script'i sozlugu import etmek zorunda kalmaz.
  var navToggleEl = document.getElementById('nav-toggle');
  var labelMenuOpen = navToggleEl.dataset.labelOpen;
  var labelMenuClose = navToggleEl.dataset.labelClose;

  // header border on scroll -- histerezis: esigin tam ustunde gidip gelen
  // kucuk scroll oynamalari sinifi surekli acip kapatmasin
  var header = document.getElementById('site-header');
  var isScrolled = false;
  var headerTicking = false;
  function applyScrolledState(){
    headerTicking = false;
    var y = window.scrollY;
    if(!isScrolled && y > 24){ isScrolled = true; header.classList.add('scrolled'); }
    else if(isScrolled && y < 6){ isScrolled = false; header.classList.remove('scrolled'); }
  }
  document.addEventListener('scroll', function(){
    if(!headerTicking){ requestAnimationFrame(applyScrolledState); headerTicking = true; }
  }, {passive:true});
  applyScrolledState();

  // tema degistirme: <html data-theme> + localStorage
  var themeToggle = document.querySelector('.theme-toggle');
  if(themeToggle){
    // BaseLayout'un head'deki senkron script'i data-theme'i sayfa boyanmadan once
    // yazar; burada gercek degeri okuyup baslangic aria-pressed'i duzeltiyoruz
    // (statik markup'ta tema bilinmedigi icin varsayilan "false" yazilmisti).
    themeToggle.setAttribute('aria-pressed', String(document.documentElement.getAttribute('data-theme') === 'dark'));
    themeToggle.addEventListener('click', function(){
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      themeToggle.setAttribute('aria-pressed', String(next === 'dark'));
      // tarayici cubugu / kaydirma cubugu da yeni temaya gecsin
      var meta = document.querySelector('meta[name="theme-color"]');
      if(meta) meta.setAttribute('content', next === 'dark' ? '#0A0B0D' : '#F4F4F2');
      // engellenmis site verisinde firlatir; tema yine de degissin diye sarmalanir
      try { localStorage.setItem('theme', next); } catch(e) {}
    });
  }

  // mobile nav toggle
  var toggle = document.getElementById('nav-toggle');
  var mobileNav = document.getElementById('mobile-nav');
  toggle.addEventListener('click', function(){
    var open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? labelMenuOpen : labelMenuClose);
    if(open){ mobileNav.setAttribute('hidden',''); } else { mobileNav.removeAttribute('hidden'); }
  });
  mobileNav.addEventListener('click', function(e){
    if(e.target.tagName === 'A'){
      toggle.setAttribute('aria-expanded','false');
      toggle.setAttribute('aria-label', labelMenuOpen);
      mobileNav.setAttribute('hidden','');
    }
  });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true'){
      toggle.click();
      toggle.focus();
    }
  });

  // active nav link: closest section whose top has passed a reference line (robust vs fast scroll)
  var navSections = ['hakkimda','ne-yapiyorum','projeler','yazilar','off-the-clock','iletisim']
    .map(function(id){ return document.getElementById(id); });
  var navLinks = document.querySelectorAll('.nav-links a[href^="#"]');
  var ticking = false;

  function updateActiveLink(){
    var scrollTop = window.scrollY;
    var refLine = scrollTop + window.innerHeight * 0.35;
    var currentId = null;
    for(var i = 0; i < navSections.length; i++){
      var el = navSections[i];
      if(!el) continue;
      var top = el.getBoundingClientRect().top + scrollTop;
      if(top <= refLine){ currentId = el.id; }
    }
    if(currentId){
      navLinks.forEach(function(link){
        link.classList.toggle('active', link.getAttribute('href') === '#' + currentId);
      });
    }
    ticking = false;
  }
  document.addEventListener('scroll', function(){
    if(!ticking){ requestAnimationFrame(updateActiveLink); ticking = true; }
  }, {passive:true});
  updateActiveLink();
</script>
