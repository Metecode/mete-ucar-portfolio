---
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

// Formun calisma aninda kullandigi metinler. Sunucuda cozulup data-i18n ile
// aktarilir; boylece istemci script'i sozlugu import etmek zorunda kalmaz ve
// iki dilin tamami JS paketine girmez. Kaynak yine tek yer: src/i18n/ui.ts.
// {email} / {status} yer tutuculari istemcide doldurulur.
const formStrings = {
  sending: t('contact.form.sending', lang),
  success: t('contact.form.success', lang),
  timeout: t('contact.error.timeout', lang),
  offline: t('contact.error.offline', lang),
  invalid: t('contact.error.invalid', lang),
  rateLimit: t('contact.error.rateLimit', lang),
  server: t('contact.error.server', lang),
  http: t('contact.error.http', lang),
  network: t('contact.error.network', lang),
};
---

<section id="iletisim" class="section reveal">
  <div class="container contact-grid">
    <div>
      <h2>{t('contact.title', lang)}</h2>
      <p>{t('contact.intro', lang)}</p>
      <ul class="contact-links">
        <li><a href="mailto:i.meteucar@gmail.com">i.meteucar@gmail.com</a></li>
        <li><a href="https://www.linkedin.com/in/meteucar/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://github.com/Metecode" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>

    <form
      class="contact-form"
      id="contact-form"
      action="https://formspree.io/f/moeveebz"
      method="POST"
      novalidate
      data-i18n={JSON.stringify(formStrings)}
    >
      <!-- honeypot: botlar doldurur, Formspree bu alan doluysa gönderimi eler -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" aria-hidden="true" />
      <div class="form-field">
        <label for="name">{t('contact.form.name', lang)}</label>
        <input type="text" id="name" name="name" autocomplete="name" required />
      </div>
      <div class="form-field">
        <label for="email">{t('contact.form.email', lang)}</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>
      <div class="form-field">
        <label for="message">{t('contact.form.message', lang)}</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">
        {t('contact.form.submit', lang)}
        <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style is:global>
  /* ---------- contact ---------- */
  .contact-grid{display:grid;gap:48px;}
  @media (min-width:860px){ .contact-grid{grid-template-columns:1fr 1.2fr;} }
  .contact-grid h2{font-size:clamp(26px,3.4vw,36px);margin-top:2px;}
  .contact-grid > div > p{color:var(--text-secondary);max-width:44ch;margin-top:16px;font-size:16px;line-height:1.65;}
  .contact-links{margin-top:28px;display:flex;flex-direction:column;gap:14px;}
  .contact-links a{font-size:15px;color:var(--text-primary);border-bottom:1px solid var(--border-strong);
    display:inline-block;width:fit-content;padding-bottom:2px;transition:color var(--dur) var(--ease),border-color var(--dur) var(--ease);}
  .contact-links a:hover{color:var(--accent);border-color:var(--accent);}

  .contact-form{display:flex;flex-direction:column;gap:20px;}
  .form-field{display:flex;flex-direction:column;gap:8px;}
  .form-field label{font-size:13.5px;color:var(--text-secondary);}
  .form-field input,.form-field textarea{background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius-sm);padding:12px 14px;font-size:16px;color:var(--text-primary);
    min-height:48px;transition:border-color var(--dur) var(--ease);}
  .form-field textarea{min-height:120px;resize:vertical;}
  .form-field input:focus,.form-field textarea:focus{border-color:var(--accent);outline:none;}
  .contact-form .btn{align-self:flex-start;}
  .contact-form .btn:disabled{opacity:.6;cursor:progress;}
  /* gonderim basarili olunca alanlar gizlenir, sadece durum mesaji kalir */
  .contact-form.is-sent > *:not(.form-status){display:none;}
  .form-status{font-size:13.5px;color:var(--text-secondary);min-height:20px;line-height:1.55;}
  .form-status.is-success{color:var(--success);}
  /* hata mesaji notr metinden ayirt edilebilsin diye kendi rengi ve sol seridi var */
  .form-status.is-error{color:var(--danger);border-left:2px solid var(--danger);padding-left:10px;}
</style>

<script>
  // contact form -> Formspree (AJAX; sayfa yonlendirilmez)
  var form = document.getElementById('contact-form');
  var status = document.getElementById('form-status');
  var submitBtn = form.querySelector('button[type="submit"]');
  var submitMarkup = submitBtn.innerHTML;
  var sending = false;

  var MAILTO = 'i.meteucar@gmail.com';

  // aktif dilin metinleri sunucudan gelir (bkz. frontmatter'daki formStrings)
  var TEXT = JSON.parse(form.dataset.i18n);

  function fill(text, values){
    return text.replace(/\{(\w+)\}/g, function(match, key){
      return key in values ? String(values[key]) : match;
    });
  }

  // her hata ayni cumleye dusmesin: sebebe gore ne oldugunu ve ne yapilacagini soyle
  function errorMessage(err, timedOut){
    var s = err && typeof err.status === 'number' ? err.status : 0;
    var text =
      timedOut ? TEXT.timeout :
      !navigator.onLine ? TEXT.offline :
      s === 422 ? TEXT.invalid :
      s === 429 ? TEXT.rateLimit :
      s >= 500 ? TEXT.server :
      s > 0 ? TEXT.http :
      TEXT.network;
    return fill(text, { email: MAILTO, status: s });
  }

  function setStatus(text, state){
    status.textContent = text;
    status.classList.toggle('is-success', state === 'success');
    status.classList.toggle('is-error', state === 'error');
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(sending) return;

    // form novalidate: dogrulamayi gonderim aninda kendimiz tetikliyoruz ki
    // bos alanlar Formspree'ye gitmesin
    if(!form.checkValidity()){
      form.reportValidity();
      return;
    }

    sending = true;
    submitBtn.disabled = true;
    submitBtn.textContent = TEXT.sending;
    setStatus('', null);

    // istek asla asili kalmasin: 15sn sonra iptal edilir, buton tekrar aktiflesir
    var timedOut = false;
    var controller = new AbortController();
    var timer = setTimeout(function(){ timedOut = true; controller.abort(); }, 15000);

    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' },
      signal: controller.signal
    })
    .then(function(res){
      if(!res.ok) throw res;
      form.reset();
      form.classList.add('is-sent');
      setStatus(TEXT.success, 'success');
    })
    .catch(function(err){
      setStatus(errorMessage(err, timedOut), 'error');
    })
    .finally(function(){
      clearTimeout(timer);
      sending = false;
      submitBtn.disabled = false;
      submitBtn.innerHTML = submitMarkup;
    });
  });
</script>
